{
  "name": "lig-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Development checks for lig — Life is Graph",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "cargo run --locked",
    "build": "cargo build --locked",
    "test": "cargo test --locked --all-targets --all-features",
    "format": "cargo fmt --all && prettier --write .",
    "format:check": "cargo fmt --all -- --check && prettier --check .",
    "lint": "cargo clippy --locked --all-targets --all-features -- -D warnings",
    "typecheck": "cargo check --locked --all-targets --all-features",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
